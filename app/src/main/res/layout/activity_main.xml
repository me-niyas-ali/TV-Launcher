<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim" />

    <!-- 48dp / 27dp padding keeps content inside the TV overscan safe area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <!-- Top settings panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/title_home"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnSearch"
                style="@style/TopBarButton"
                android:contentDescription="@string/cd_search"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btnWifi"
                style="@style/TopBarButton"
                android:contentDescription="@string/cd_wifi"
                android:src="@drawable/ic_wifi" />

            <ImageButton
                android:id="@+id/btnBluetooth"
                style="@style/TopBarButton"
                android:contentDescription="@string/cd_bluetooth"
                android:src="@drawable/ic_bluetooth" />

            <ImageButton
                android:id="@+id/btnDateTime"
                style="@style/TopBarButton"
                android:contentDescription="@string/cd_date_time"
                android:src="@drawable/ic_schedule" />

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/TopBarButton"
                android:contentDescription="@string/cd_menu"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Home screen -->
            <LinearLayout
                android:id="@+id/homeContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingTop="24dp">

                <TextClock
                    android:id="@+id/clockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/text_primary"
                    android:textSize="88sp" />

                <TextClock
                    android:id="@+id/clockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.08"
                    android:text="@string/favourites"
                    android:textAllCaps="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/favoritesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/favoritesEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        android:text="@string/favourites_empty"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/allAppsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:drawablePadding="12dp"
                    android:drawableStart="@drawable/ic_apps"
                    android:drawableTint="@color/text_primary"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="12dp"
                    android:text="@string/all_apps"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- All apps screen -->
            <FrameLayout
                android:id="@+id/appsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/appsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="16dp"
                    android:paddingBottom="32dp" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
