<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark tone: light text on dark wallpapers and custom images -->
    <style name="Theme.TVLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="launcherTextPrimary">@color/text_primary</item>
        <item name="launcherTextSecondary">@color/text_secondary</item>
        <item name="launcherFocusFill">@color/focus_fill</item>
        <item name="launcherPillFill">@color/pill_fill</item>
        <item name="launcherAccent">@color/accent</item>
        <item name="launcherScrimTop">@color/scrim_top</item>
        <item name="launcherScrimBottom">@color/scrim_bottom</item>
    </style>

    <!-- Light tone: dark text on light gradient wallpapers -->
    <style name="Theme.TVLauncher.Light">
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="colorAccent">@color/light_accent</item>
        <item name="colorControlActivated">@color/light_accent</item>

        <item name="launcherTextPrimary">@color/light_text_primary</item>
        <item name="launcherTextSecondary">@color/light_text_secondary</item>
        <item name="launcherFocusFill">@color/light_focus_fill</item>
        <item name="launcherPillFill">@color/light_pill_fill</item>
        <item name="launcherAccent">@color/light_accent</item>
        <item name="launcherScrimTop">@color/light_scrim_top</item>
        <item name="launcherScrimBottom">@color/light_scrim_bottom</item>
    </style>

    <style name="Theme.TVLauncher.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="TopBarButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?attr/launcherTextPrimary</item>
    </style>
</resources>
